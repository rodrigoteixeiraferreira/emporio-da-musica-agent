# Copy this file to .env and fill in your key.
# Free key: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=

# Optional: model id (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: the agent's "today", ISO date or datetime (default: real current time).
# Times are interpreted in America/Campo_Grande. Examples were generated with 2026-03-25T10:00.
# STORE_TODAY=2026-03-25T10:00
